    { "src": "System/Menu.src",          "dat": "MENU.DAT" },
    { "src": "System/Camera.src",        "dat": "CAMERA.DAT" },
    { "src": "System/Music.src",         "dat": "MUSIC.DAT" },
    { "src": "System/SFX.src",           "dat": "SFX.DAT" },
    { "src": "System/ParticleFX.src",    "dat": "PARTICLEFX.DAT" },
    { "src": "System/VisualFX.src",      "dat": "VISUALFX.DAT" }
  ],
  "engine": {
    "target": "Gothic2Notr",
    "files": [ "Gothic2Notr.exe", "Tempest.dll", "dxcompiler.dll", "dxil.dll" ]
  }

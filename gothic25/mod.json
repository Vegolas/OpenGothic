{
  "id": "gothic25",
  "title": "Gothic 2.5",
  "version": "0.1.0",
  "authors": "Gothic 2.5 team",
  "game": "g2notr",
  "archive": "Gothic25.mod",
  "ini": "Gothic25.ini",
  "ini_values": {
    "player": "PC_HERO",
    "world": "NewWorld\\NewWorld.zen"
  },
  "pack": {
    "exclude": [
      "**/README.md",
